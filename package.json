{
  "name": "@deterministic-code/deterministic-generators-common",
  "version": "0.1.0",
  "description": "TypeScript validators and YAML parser for the deterministic-specifications contract.",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./typescript/validator/index.ts",
      "import": "./typescript/validator/dist/index.js"
    },
    "./parser": {
      "types": "./typescript/parser/specification-parser.ts",
      "import": "./typescript/parser/dist/specification-parser.js"
    }
  },
  "files": [
    "typescript/validator/dist",
    "typescript/validator/index.ts",
    "typescript/validator/types.ts",
    "typescript/validator/SpecValidator.ts",
    "typescript/validator/validators",
    "typescript/parser/dist",
    "typescript/parser/*.ts",
    "typescript/parser/parser"
  ],
  "scripts": {
    "prepare": "npm run build",
    "test": "npm test --prefix typescript",
    "build": "esbuild typescript/validator/index.ts --bundle --format=esm --platform=node --packages=external --outfile=typescript/validator/dist/index.js && esbuild typescript/validator/validators/engines.ts --bundle --format=esm --platform=node --packages=external --outfile=typescript/validator/validators/engines.js && esbuild typescript/parser/specification-parser.ts --bundle --format=esm --platform=node --packages=external --outfile=typescript/parser/dist/specification-parser.js"
  },
  "dependencies": {
    "ajv": "^8.18.0",
    "pluralize": "^8.0.0",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deterministic-code/deterministic-generators-common.git"
  },
  "engines": {
    "node": ">=22.18"
  }
}
