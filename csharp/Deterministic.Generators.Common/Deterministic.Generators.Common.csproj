<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Deterministic.Generators.Common</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Version>0.1.0</Version>
    <Authors>deterministic-code</Authors>
    <Company>deterministic-code</Company>
    <Description>Parser and validators for the deterministic-specifications contract.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/deterministic-code/deterministic-generators-common</PackageProjectUrl>
    <RepositoryUrl>https://github.com/deterministic-code/deterministic-generators-common</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IsPackable>true</IsPackable>
    <PackageOutputPath>$(MSBuildThisFileDirectory)../artifacts/</PackageOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="JsonSchema.Net" Version="7.3.4" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Deterministic.Generators.Common.Tests" />
  </ItemGroup>
</Project>
